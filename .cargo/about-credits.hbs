{{! Handlebars tmpl to transform the JSON data generated by `cargo-about` }}
{{! to only the data we need. Significantly slims down the embed size.    }}

{"crates":[
{{~#each crates~}}
{"name":{{{json package.name}}},"version":{{{json package.version}}},"license":{{{json license}}}}
{{~#unless @last}},{{/unless~}}
{{~/each~}}
],"licenses":[
{{~#each licenses~}}
{"id":{{{json id}}},"text":{{{json text}}},"crates":[
{{~#each used_by~}}
"{{{crate.name}}} {{{crate.version}}}"
{{~#unless @last}},{{/unless~}}
{{~/each~}}
]}
{{~#unless @last}},{{/unless~}}
{{~/each~}}
]}
